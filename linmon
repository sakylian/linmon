#!/bin/bash
# linmon 命令包装脚本
# 自动解析真实路径，支持直接运行或通过软链接运行

# macOS 的 BSD readlink 不支持 -f，用 realpath 兼容；两者都不存在时回退到 dirname
if command -v realpath >/dev/null 2>&1; then
    SCRIPT_PATH="$(realpath "$0")"
else
    SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
fi
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

if [ -f "$SCRIPT_DIR/venv/bin/python3" ]; then
    exec "$SCRIPT_DIR/venv/bin/python3" "$SCRIPT_DIR/linmon.py" "$@"
else
    exec python3 "$SCRIPT_DIR/linmon.py" "$@"
fi
